#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONTENTS_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
RESOURCES_DIR="$CONTENTS_DIR/Resources"

# Ensure PATH includes standard Homebrew, MacPorts, and user local bin
export PATH="/opt/homebrew/bin:/usr/local/bin:$PATH"

# Discover Java runtime:
JAVA_BIN=""
if [ -n "$JAVA_HOME" ] && [ -x "$JAVA_HOME/bin/java" ]; then
    JAVA_BIN="$JAVA_HOME/bin/java"
elif [ -x "/opt/homebrew/opt/openjdk@21/bin/java" ]; then
    JAVA_BIN="/opt/homebrew/opt/openjdk@21/bin/java"
elif [ -x "/opt/homebrew/opt/openjdk/bin/java" ]; then
    JAVA_BIN="/opt/homebrew/opt/openjdk/bin/java"
elif [ -x "/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home/bin/java" ]; then
    JAVA_BIN="/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home/bin/java"
elif [ -x "/usr/libexec/java_home" ]; then
    JH="$(/usr/libexec/java_home 2>/dev/null || true)"
    if [ -n "$JH" ] && [ -x "$JH/bin/java" ]; then
        JAVA_BIN="$JH/bin/java"
    fi
fi

if [ -z "$JAVA_BIN" ] && command -v java >/dev/null 2>&1; then
    JAVA_BIN="$(command -v java)"
fi

if [ -z "$JAVA_BIN" ]; then
    osascript -e 'tell app "System Events" to display alert "Java not found" message "Unciv requires Java 17 or newer. Please install OpenJDK via Homebrew (brew install openjdk@21)."'
    exit 1
fi

cd "$RESOURCES_DIR"
exec "$JAVA_BIN" -Xmx4G -jar "$RESOURCES_DIR/Unciv.jar" "$@"
